% A fixed-width bar filling up. Segments are proportional to what a real session looks like
% after an hour: the rulebook is small, the files it read and the command output are not.
\newcommand{\contextbar}{%
  \par\noindent\begin{tikzpicture}[x=1mm, y=1mm]
    \useasboundingbox (0,-13) rectangle (134,7);
    \node[gp eyebrow=NovaMuted] at (0,4.2) {\lsp[13]{EVERYTHING IT CAN SEE AT ONCE}};
    \path[rounded corners=2mm, fill=NovaCard] (0,0) rectangle (134,-8);
    \begin{scope}
      \clip[rounded corners=2mm] (0,0) rectangle (134,-8);
      \fill[NovaYellow]  (0,0)   rectangle (8,-8);
      \fill[NovaBody]    (8,0)   rectangle (30,-8);
      \fill[NovaBlue]    (30,0)  rectangle (70,-8);
      \fill[NovaTeal]    (70,0)  rectangle (104,-8);
    \end{scope}
    \draw[NovaLine, line width=0.9pt, rounded corners=2mm] (0,0) rectangle (134,-8);
    \node[as name, text=NovaYellow, font=\scriptsize\bfseries, anchor=north west] at (0,-9.4) {rulebook};
    \node[as name, text=NovaBody,   font=\scriptsize\bfseries] at (21,-9.4)  {your messages};
    \node[as name, text=NovaBlue,   font=\scriptsize\bfseries] at (50,-9.4)  {every file it read};
