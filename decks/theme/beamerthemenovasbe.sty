% section divider frame: \sectionslide{W4}{kicker}{Title}{subtitle}
\newcommand{\sectionslide}[5][NovaTeal]{%
  \begingroup
  \hue{#1}%
  \begin{frame}[plain]
    \vfill
    {\displayfont\fontsize{58}{58}\selectfont\bfseries\color{#1}#2}\par\vskip1.1em
    {\scriptsize\bfseries\color{#1}\lsp[16]{\MakeUppercase{#3}}}\par\vskip0.7em
    {\displayfont\fontsize{40}{44}\selectfont\bfseries\color{NovaFg}#4}\par\vskip0.7em
    {\color{NovaBody}\large #5}
    \vfill
  \end{frame}
  \endgroup}

