% ───────────────────────────────────────────── prompt-engineering bloopers
% Three years of tricks that moved the score of a next-word machine, as a table: the year, the
% prompt, the effect, and the source. A real tabular rather than TikZ, so the source links
% are clickable (hyperref annotations do not survive inside a TikZ node). What ended it, a model
% that works the problem out first, is the caption and the note, not a row.
\RequirePackage{colortbl}
\RequirePackage{array}
\RequirePackage{booktabs}
\newcommand{\blq}[1]{\emph{#1}}
\newcommand{\bloopers}{%
  \par\noindent{\tiny\renewcommand{\arraystretch}{1.4}\arrayrulecolor{NovaLine}%
  \setlength{\tabcolsep}{1mm}%
  \begin{tabular}{@{}>{\bfseries\color{NovaMuted}}p{9mm}>{\color{NovaFg}\raggedright}p{45mm}>{\color{NovaBody}\raggedright}p{48mm}>{\color{NovaMuted}\raggedright\arraybackslash}p{26mm}@{}}
  \lsp[12]{WHEN} & \lsp[12]{PROMPT} & \lsp[12]{EFFECT(S)} & \lsp[12]{SOURCE} \\[-0.6mm]
  \specialrule{0.9pt}{0pt}{0.4mm}
  2022 & \blq{``Let's think step by step.''} & maths score 18\% $\to$ 79\%, same model &
    \srclink{https://arxiv.org/abs/2205.11916}{Kojima et al., NeurIPS} \\ \hline
  2023 & \blq{``Take a deep breath and work on this problem step-by-step.''} & maths score 72\% $\to$ 80\%, over ``step by step'' &
    \srclink{https://arxiv.org/abs/2309.03409}{Yang et al., Google DeepMind} \\ \hline
  2023 & \blq{``This is very important to my career.''} & +8\% on instruction tasks &
    \srclink{https://arxiv.org/abs/2307.11760}{Li et al.} \\ \hline
  2023 & \blq{``I'm going to tip \$200 for a better solution!''} & +45\% ``quality'' on GPT-4, judged by hand on twenty questions &
    \srclink{https://arxiv.org/abs/2312.16171}{Bsharat et al., MBZUAI} \\ \hline
  2024 & \blq{``Please'' and ``thank you''} & rude prompts score lower; polite ones cost ``tens of millions'' in power &
    \srclink{https://arxiv.org/abs/2402.14531}{Yin et al.} · Altman, on X (2025) \\
  \specialrule{0.9pt}{0pt}{0pt}
  \end{tabular}\par}%
}

