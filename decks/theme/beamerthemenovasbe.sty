}
% a 10x8 grid at (x,y) with cell pitch #3; #4 = index/colour pairs; free = outline, buf = hatched
\newcommand{\tmgrid}[4]{%
  \foreach \i/\c in {#4} {
    \pgfmathsetmacro{\cx}{#1+mod(\i,10)*#3}
    \pgfmathsetmacro{\cy}{#2-floor(\i/10)*#3}
    \ifthenelse{\equal{\c}{free}}
      {\draw[NovaMuted, line width=0.35pt] (\cx,\cy) rectangle ({\cx+0.8*#3},{\cy-0.8*#3});}
      {\ifthenelse{\equal{\c}{buf}}
        {\draw[NovaMuted, line width=0.35pt] (\cx,\cy) rectangle ({\cx+0.8*#3},{\cy-0.8*#3});
         \draw[NovaMuted, line width=0.35pt] (\cx,{\cy-0.8*#3}) -- ({\cx+0.8*#3},\cy);}
        {\fill[\c] (\cx,\cy) rectangle ({\cx+0.8*#3},{\cy-0.8*#3});}}
  }}
\newcommand{\tmrow}[4]{% y colour label value
