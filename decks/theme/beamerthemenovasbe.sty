    \node[as label=NovaTeal, anchor=north, align=center, text width=18mm] at (127,-13.6)
      {green: stop};
    % stage 2: red sends the same prompt to a new agent; only the repo carries over
    \ifnum#1>1
      \draw[as arrow=NovaAccent, rounded corners=2mm]
        (114.4,-15.5) -- (117.5,-15.5) -- (117.5,-30) -- (1,-30) -- (1,-11) -- (8.2,-11);
      \node[as label=NovaAccent, fill=NovaBg, inner xsep=1.6mm, anchor=center] at (59,-30)
        {red: again, with a fresh agent};
      \node[rl tag=NovaMuted] at (13,-24.4) {never changes};
      \node[rl tag=NovaMuted] at (42,-24.4) {remembers nothing};
      \node[rl tag=NovaTeal]  at (80,-24.4) {keeps everything};
    \fi
    % stage 3: the signs
    \ifnum#1>2
      \ralphsign{0}{THE PROMPT}{One task. Full code, no placeholders. What \emph{done}
        looks like.}
      \ralphsign{34}{WHEN IT FAILS}{Don't argue with a run. Put a sign in the prompt, and
        start again.}
      \ralphsign{68}{THE MEMORY}{Spec, plan, rulebook. What it learns goes in a file, or it
        is gone.}
      \ralphsign{103}{THE STOP}{Tests and a commit, every run. A cap on runs. Then you
        read it all.}
    \fi
  \end{tikzpicture}%
}

