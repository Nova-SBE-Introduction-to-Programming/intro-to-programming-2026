\tikzset{
  tm text/.style ={font=\tiny\ttfamily, text=NovaBg, anchor=north west, inner sep=0pt},
  tm dim/.style  ={font=\tiny\ttfamily, text=NovaLine, anchor=north west, inner sep=0pt},
