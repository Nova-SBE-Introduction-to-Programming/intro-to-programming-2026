\setbeamerfont{frametitle}{size=\LARGE, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\scriptsize, series=\bfseries}
\setbeamerfont{normal text}{size=\normalsize}

% kicker colour, set per frame with \hue{...} before \begin{frame}
\newcommand{\novakickercolor}{NovaAccent}
\newcommand{\hue}[1]{\renewcommand{\novakickercolor}{#1}}

\setbeamertemplate{frametitle}{%
  \vskip0.72em%
  \ifx\insertframesubtitle\@empty\else
    {\usebeamerfont{framesubtitle}\color{\novakickercolor}%
     \lsp[16]{\MakeUppercase{\insertframesubtitle}}\par\vskip0.42em}%
  \fi
  {\displayfont\usebeamerfont{frametitle}\color{NovaFg}%
   \setlength{\baselineskip}{1.06\baselineskip}\insertframetitle\par}%
  \vskip0.28em%
}

% footer: course line, slide number, and a progress bar flush to the bottom edge
\newlength{\novaprogress}
\newcommand{\footertext}{}
\newcommand{\setfootertext}[1]{\renewcommand{\footertext}{#1}}
\setbeamertemplate{footline}{%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=1.4ex,dp=0.7ex,leftskip=13mm,rightskip=13mm]{footer}%
      {\tiny\color{NovaMuted}\footertext}\hfill
      {\tiny\color{NovaMuted}\insertframenumber\,/\,\inserttotalframenumber}%
    \end{beamercolorbox}%
  }%
  % plain dimen arithmetic: pgfmath here produced overfull boxes every frame.
  % On an early pass \inserttotalframenumber can be 0 or 1 while \insertframenumber is the real
  % frame, so the multiplier must be clamped BEFORE multiplying, not after: \paperwidth/1 * 36
  % is past max dimen and aborts the run with "Arithmetic overflow". Clamping first also gives
  % the right answer, since progress can never exceed the full width.
  \setlength{\novaprogress}{0pt}%
  \ifnum\inserttotalframenumber>0\relax
    \setlength{\novaprogress}{\paperwidth}%
    \ifnum\insertframenumber<\inserttotalframenumber\relax
      \divide\novaprogress by \inserttotalframenumber\relax
      \multiply\novaprogress by \insertframenumber\relax
    \fi
  \fi
  \hbox to \paperwidth{\color{NovaAccent}\rule[0pt]{\novaprogress}{1.1pt}\hfil}%
}

% ─────────────────────────────────────────────────────────── building blocks
% inline code chip
\newcommand{\code}[1]{%
  \tcbox[on line, boxsep=0pt, left=1.3mm, right=1.3mm, top=0.6mm, bottom=0.6mm,
         colback=NovaChip, boxrule=0pt, arc=1.1mm]%
        {\monofont\small\color{NovaFg}#1}}

% a filename or branch name used AS a frame title: the inline \code chip is \small, which
% left these titles looking like a stray pill in an empty title bar
\newcommand{\codetitle}[1]{{\monofont\color{NovaFg}#1}}

% a photo, clipped to the card radius and lifted the same way, so artwork sits in the same
% visual system as the cards rather than as a pasted rectangle
\newsavebox{\novapicbox}
\newcommand{\roundedpic}[2][0.5\linewidth]{%
  \sbox{\novapicbox}{\includegraphics[width=#1]{#2}}%
  \begin{tikzpicture}
    \path[fill=NovaShadow, rounded corners=3mm]
      (0.4mm,-0.45mm) rectangle ({\wd\novapicbox+0.4mm}, {\ht\novapicbox-0.45mm});
    \begin{scope}
      \clip[rounded corners=3mm] (0,0) rectangle (\wd\novapicbox, \ht\novapicbox);
      \node[anchor=south west, inner sep=0pt] at (0,0) {\usebox{\novapicbox}};
    \end{scope}
  \end{tikzpicture}}

% the \code chip, sized to carry a slide by itself: for the rare literal that IS the point
\newcommand{\codeline}[1]{%
  \tcbox[on line, boxsep=0pt, left=3.6mm, right=3.6mm, top=2.4mm, bottom=2.4mm,
         colback=NovaChip, boxrule=0pt, arc=2.4mm]%
        {\monofont\color{NovaFg}#1}}

% ────────────────────────────────────────────── a diff, the way git prints one
% minted drives Pygments' diff lexer, so the +/- lines are lexed rather than hand-coloured and
% a slide cannot drift out of sync with what the shell would actually show. Two conditions:
% tectonic needs -Z shell-escape (build.sh passes it) with pygmentize on PATH, and any frame
% holding one of these must be \begin{frame}[fragile] — minted is verbatim.
% Pygments' default style is a different deck (pillar-box red, spring green, bold navy), so the
% four diff tokens are repainted in the course palette. It has to be done as a patch to
% \minted@defstyle rather than once in the preamble: minted replays Pygments' own style
% definitions before every single listing, which would undo a preamble override.
\RequirePackage{minted}
\setminted{fontsize=\scriptsize, breaklines=false, autogobble, numbers=none,
           baselinestretch=1.02}
\@namedef{nova@PYG@gi}{\def\PYG@tc##1{\textcolor{NovaTeal}{##1}}}%   added
\@namedef{nova@PYG@gd}{\def\PYG@tc##1{\textcolor{NovaAccent}{##1}}}% removed
\@namedef{nova@PYG@gh}{\def\PYG@tc##1{\textcolor{NovaMuted}{##1}}}%  "diff --git", "======="
\@namedef{nova@PYG@gu}{\def\PYG@tc##1{\textcolor{NovaPurple}{##1}}}% "@@" hunk headers
\newcommand{\novaPYGpalette}{%
  \expandafter\let\csname PYG@tok@gi\expandafter\endcsname\csname nova@PYG@gi\endcsname
  \expandafter\let\csname PYG@tok@gd\expandafter\endcsname\csname nova@PYG@gd\endcsname
  \expandafter\let\csname PYG@tok@gh\expandafter\endcsname\csname nova@PYG@gh\endcsname
  \expandafter\let\csname PYG@tok@gu\expandafter\endcsname\csname nova@PYG@gu\endcsname}
\apptocmd{\minted@defstyle}{\novaPYGpalette}{}%
  {\PackageWarning{beamerthemenovasbe}{minted's diff colours are Pygments' own, not the palette}}
% \begin{gitdiff}[width]{the command that printed it} ... \end{gitdiff}
% The command line above the card is half the lesson: which question produces which diff.
% \VerbatimEnvironment is what lets the minted block hide inside this wrapper: it points
% fancyvrb's end-of-verbatim scan at \end{gitdiff} instead of the \end{minted} nobody types.
\newenvironment{gitdiff}[2][\linewidth]{%
  \VerbatimEnvironment
  \par\noindent{\tiny\color{NovaMuted}\monofont \$\ #2}\par\vskip1.1mm
  \begin{tcolorbox}[enhanced, width=#1, colback=NovaCard, boxrule=0pt, arc=2.4mm,
      fuzzy shadow={0.3mm}{-0.3mm}{-0.2mm}{0.05mm}{NovaShadow},
      left=3.2mm, right=3.2mm, top=2.0mm, bottom=2.0mm]%
  \begin{minted}{diff}%
}{%
  \end{minted}%
  \end{tcolorbox}}
% the same card for the case that teaches the most: the command ran and printed nothing
\newcommand{\gitnodiff}[3][\linewidth]{%
  \par\noindent{\tiny\color{NovaMuted}\monofont \$\ #2}\par\vskip1.1mm
  \begin{tcolorbox}[enhanced, width=#1, colback=NovaCard, boxrule=0pt, arc=2.4mm,
      fuzzy shadow={0.3mm}{-0.3mm}{-0.2mm}{0.05mm}{NovaShadow},
      left=3.2mm, right=3.2mm, top=2.0mm, bottom=2.0mm]%
    {\scriptsize\color{NovaMuted}\emph{#3}}%
  \end{tcolorbox}}

% pill badge
\newcommand{\pill}[2][NovaAccent]{%
  \tikz[baseline=(p.base)]{\node[fill=#1, text=NovaBg, rounded corners=1.6mm,
    inner xsep=2.2mm, inner ysep=1.0mm, font=\scriptsize\bfseries](p)
    {\lsp[11]{\MakeUppercase{#2}}};}}

% small tracked label, used above card headings
\newcommand{\eyebrow}[2][\novakickercolor]{{\scriptsize\bfseries\color{#1}\lsp[14]{\MakeUppercase{#2}}}}

% cards: a raster of equal-height boxes
\tcbset{novacard/.style={
  enhanced, colback=NovaCard, boxrule=0pt, arc=3.6mm,
  fuzzy shadow={0.35mm}{-0.35mm}{-0.25mm}{0.055mm}{NovaShadow},
  left=4.2mm, right=4.2mm, top=3.6mm, bottom=3.6mm,
  fontupper=\small\raggedright\color{NovaBody}, valign=top,
  before upper={\hyphenpenalty=10000\exhyphenpenalty=10000}}}
% used as \begin{tcbitemize}[cards] ... \end{tcbitemize}; override with raster columns=2.
% \tcbitem is bound by tcbitemize (not tcbraster), and separates items rather than
% wrapping them — hence \carditem takes its content inline.
\tcbset{cards/.style={raster columns=3, raster equal height=rows,
  raster row skip=2.8mm, raster column skip=2.8mm, novacard}}
% denser variant for four-up or text-heavy rows
\tcbset{cardsS/.style={cards, fontupper=\footnotesize\raggedright\color{NovaBody},
  left=3.6mm, right=3.6mm, top=3.1mm, bottom=3.1mm}}
% \carditem{eyebrow}{heading}{body}
\newcommand{\carditem}[3]{%
  \tcbitem \eyebrow{#1}\par\vskip1.9mm
  {\displayfont\normalsize\bfseries\color{NovaFg}#2}\par\vskip1.4mm #3}
% a card with no heading
\newcommand{\carditemplain}[2]{\tcbitem \eyebrow{#1}\par\vskip1.9mm #2}

% numbered steps
\newlist{steps}{enumerate}{1}
% Drawn with tcbox, not a TikZ node. A tikz node here leaks its fill colour onto the following
% text through pgf's colour stack whenever the frame is re-boxed, which is what the notes build
% does: in class-4-notes.pdf every numbered step rendered in the chip's 16% tint, i.e. invisible,
% while \code chips (tcbox) on the same slides were fine. Found 2026-09-22 by rendering the notes
% pages; the log never mentions it, because nothing overflows — the ink is just the wrong colour.
\newcommand{\stepchip}[1]{%
  \tcbox[on line, boxsep=0pt, left=2.0mm, right=2.0mm, top=0.9mm, bottom=0.9mm,
         colback=\novakickercolor!16!NovaBg, coltext=\novakickercolor, boxrule=0pt, arc=1.2mm]%
        {\footnotesize\bfseries #1}}
% before=\color{NovaFg}: the notes build ships each frame through pgfpages, whose box re-use
% leaves the pdf colour stack out of step, and the item bodies came out in the page background —
% invisible in class-4-notes.pdf while the same slides were perfect in class-4.pdf. Stating the
% colour inside the list overrides whatever the stack is holding. Verified by sampling pixels in
% both builds, because nothing about this reaches the log.
\setlist[steps]{label=\protect\stepchip{\arabic*}, leftmargin=9mm, labelsep=3mm,
                itemsep=1.7mm, topsep=1.6mm, parsep=0pt, before=\color{NovaFg}}
% enumitem's \setlist wins over beamer's itemize template, so name the label here too
\newcommand{\novabullet}{\raisebox{0.30ex}{\tikz{\fill[NovaAccent] (0,0) circle (1.15pt);}}}
\newcommand{\novabulletsub}{\raisebox{0.30ex}{\tikz{\fill[NovaMuted] (0,0) circle (0.85pt);}}}
% before=\color{NovaFg} for the same reason as steps above: plain itemize bodies were rendering
% in the page colour in the notes build too — Your GitHub page, Why git exists, Write one rule
% and Before next week. Same pgfpages colour stack, same silence in the log.
\setlist[itemize,1]{label=\protect\novabullet, leftmargin=5mm, labelsep=2.6mm,
                    itemsep=1.6mm, topsep=1.4mm, parsep=0pt, before=\color{NovaFg}}
\setlist[itemize,2]{label=\protect\novabulletsub, leftmargin=4.4mm, labelsep=2.2mm,
                    itemsep=1.0mm, topsep=1.0mm, parsep=0pt, before=\color{NovaFg}}

% muted lead paragraph under a frame title
\newcommand{\lead}[1]{{\color{NovaBody}#1\par}\vskip0.6em}
% NovaBody, not NovaMuted: these captions are the sentence under every figure, and muted grey
% measures 4.16:1 against the paper — under the 4.5:1 floor for body text, and thin in a lit
% lecture hall. NovaBody is 6.99:1 and still reads as secondary next to the near-black titles.
\newcommand{\muted}[1]{{\color{NovaBody}#1}}

% a full-width quote/callout with an accent rule on the left
\newtcolorbox{callout}[1][NovaAccent]{enhanced, colback=NovaCard, boxrule=0pt, arc=3.6mm,
  left=5.4mm, right=4.4mm, top=3.6mm, bottom=3.6mm,
  fuzzy shadow={0.35mm}{-0.35mm}{-0.25mm}{0.055mm}{NovaShadow},
  borderline west={2.8pt}{0pt}{#1},
  fontupper=\raggedright\color{NovaFg}}

% ─────────────────────────────────────────────────────────── editorial timeline
% Mermaid's timeline renderer boxes everything, leaves dangling arrows and will not fill the
% width, so the two history slides draw their own. \tlstop places one moment; \tlband labels a
% span above the axis. x is a fraction of \linewidth.
\tikzset{
  tl axis/.style      ={draw=NovaLine, line width=0.9pt},
  tl stem/.style      ={draw=NovaLine, line width=0.6pt, dash pattern=on 1pt off 1.6pt},
  tl band/.style      ={line width=2.4pt, draw=#1, line cap=round},
  tl bandlabel/.style ={font=\scriptsize\bfseries, text=#1, inner sep=0pt},
  tl year/.style      ={font=\scriptsize\bfseries, text=#1, anchor=south, inner sep=1.4pt},
  tl dot/.style       ={circle, fill=#1, inner sep=0pt, minimum size=5.6pt},
  tl title/.style     ={font=\scriptsize\bfseries, text=NovaFg, anchor=north, align=left,
                        inner sep=0pt, execute at begin node={\hyphenpenalty=10000
                        \exhyphenpenalty=10000\relax}},
  tl gloss/.style     ={font=\scriptsize, text=NovaBody, anchor=north, align=left, inner sep=0pt},
  tl param/.style     ={font=\scriptsize\bfseries, text=#1, anchor=north, inner sep=0pt},
}
% \tlstop{x}{colour}{year}{Title}{gloss}{card width}
% Title and gloss live in one node: a node named after the x fraction would contain a dot,
% which pgf parses as a shape reference.
% optional first argument drops a stop to a second row, so a crowded timeline can stagger
\newcommand{\tlstop}[7][0mm]{%
  \node[tl year=#3] at (#2\linewidth, 1.6mm) {#4};
  \node[tl dot=#3]  at (#2\linewidth, 0) {};
  \draw[tl stem]    (#2\linewidth, -1.1mm) -- (#2\linewidth, {-3.4mm-#1});
  \node[tl title, text width=#7] at (#2\linewidth, {-3.6mm-#1})
    {#5\\[0.7mm]{\normalfont\scriptsize\color{NovaBody}#6}};}
% \tlband[anchor]{x from}{x to}{colour}{Label}
% Sentence case, not letterspaced caps: the deck dropped those everywhere else, and an era name
% like "Autonomous agentic" is already wider than the span it labels.
% The label hugs the band's leading edge; pass [east] and it hugs the trailing edge instead,
% which is how the last era stays on the page rather than running into the right margin.
\newcommand{\tlband}[5][west]{%
  \draw[tl band=#4] (#2\linewidth, 7.4mm) -- (#3\linewidth, 7.4mm);
  \def\tl@anchor{#1}\def\tl@west{west}%
  \ifx\tl@anchor\tl@west \def\tl@labelx{#2}\else \def\tl@labelx{#3}\fi
  \node[tl bandlabel=#4, anchor=#1] at (\tl@labelx\linewidth, 9.8mm) {#5};}

% ── one image per stop on the run-up slide
% Real pictures rather than drawn glyphs, at the user's request: the machine itself, the four
% points no straight line can split, layers, a cell that feeds itself, and the transformer nobody
% means in a paper. Sources and licences are credited on the slide; files live in figures/tl-*.
% \tlpic{x as a fraction of \linewidth}{y}{height}{file}
\newcommand{\tlpic}[4]{%
  \node[anchor=north, inner sep=0pt] at (#1\linewidth,#2)
    {\includegraphics[height=#3]{figures/#4}};}

% ─────────────────────────────────────────────────── a transcript, as a transcript
% Reasoning is easier to believe when you watch it happen than when it is described, so the
% example slide is a chat mock-up. The thinking block is deliberately the odd one out: no fill,
% a dashed rule, italic. It is not a message anyone sent — it is the model working.
% \begin{chatsaid}[fill]{who}{label colour}{width} ... \end{chatsaid}
\newenvironment{chatsaid}[4][NovaCard]{%
  {\scriptsize\bfseries\color{#3}\lsp[14]{\MakeUppercase{#2}}}\par\vskip1.0mm
  \begin{tcolorbox}[enhanced, width=#4, colback=#1, boxrule=0pt, arc=3mm,
      fuzzy shadow={0.3mm}{-0.3mm}{-0.2mm}{0.05mm}{NovaShadow},
      left=4mm, right=4mm, top=2.8mm, bottom=2.8mm,
      fontupper=\small\raggedright\color{NovaFg}]%
}{\end{tcolorbox}}
\newenvironment{chatthinks}[1][\linewidth]{%
  {\scriptsize\bfseries\color{NovaPurple}\lsp[14]{THINKING}}\par\vskip1.0mm
  \begin{tcolorbox}[enhanced, width=#1, colback=NovaBg, boxrule=0pt, arc=3mm,
      borderline={0.9pt}{0pt}{NovaLine, dash pattern=on 1.5mm off 1.1mm},
      left=4mm, right=4mm, top=2.8mm, bottom=2.8mm,
      fontupper=\small\itshape\raggedright\color{NovaMuted}]%
}{\end{tcolorbox}}

% ── a transcript with the loop drawn down its left edge
% Each turn is a box on a vertical spine, labelled by what the model is doing (reason, act,
% observe, answer) so the ReAct slide that follows only has to name what the room just watched.
% \begin{turn}[fill]{LABEL}{label colour} ... \end{turn}; the reasoning turns use turnthinks.
\newtcolorbox{turn}[3][NovaCard]{enhanced, colback=#1, colframe=#1, boxrule=0pt, arc=2.4mm,
  left=3.4mm, right=3.4mm, top=1.1mm, bottom=1.1mm,
  width=\dimexpr\linewidth-24mm\relax, enlarge left by=24mm,
  fontupper=\scriptsize\raggedright\color{NovaFg},
  overlay={%
    \draw[NovaLine, line width=0.9pt] ([xshift=-4.2mm, yshift=1.8mm]frame.north west)
      -- ([xshift=-4.2mm, yshift=-1.8mm]frame.south west);
    \fill[#3] ([xshift=-4.2mm]frame.west) circle (1.1mm);
    \node[anchor=east, font=\scriptsize\bfseries, text=#3, inner sep=0pt]
      at ([xshift=-8mm]frame.west) {\lsp[12]{\MakeUppercase{#2}}};}}
% The same turn, labelled by WHO is acting instead of by which part of the loop: the icons are the
% ones the stack slides introduced, one colour per actor, so the same actor never appears twice in
% two colours. \begin{turnwho}[fill]{you|model|harness} ... \end{turnwho}
\newcommand{\turnwhoicon}[1]{%
  \ifstrequal{#1}{you}{\icperson[NovaBody]{0}{0}}{%
    \ifstrequal{#1}{model}{\icmodel[NovaPurple]{0}{0}}{\icharness[NovaAccent]{0}{0}}}}
% via \colorlet, not by expanding a macro into the option list: pgf builds option keys with
% \csname, and \ifstrequal is not expandable there
\newcommand{\turnwhocolour}[1]{%
  \ifstrequal{#1}{you}{\colorlet{turnwhoc}{NovaBody}}{%
    \ifstrequal{#1}{model}{\colorlet{turnwhoc}{NovaPurple}}{\colorlet{turnwhoc}{NovaAccent}}}}
\newtcolorbox{turnwho}[2][NovaCard]{enhanced, colback=#1, colframe=#1, boxrule=0pt, arc=2.4mm,
  left=3.4mm, right=3.4mm, top=1.1mm, bottom=1.1mm,
  width=\dimexpr\linewidth-24mm\relax, enlarge left by=24mm,
  fontupper=\scriptsize\raggedright\color{NovaFg},
  overlay={%
    \draw[NovaLine, line width=0.9pt] ([xshift=-4.2mm, yshift=1.8mm]frame.north west)
      -- ([xshift=-4.2mm, yshift=-1.8mm]frame.south west);
    \turnwhocolour{#2}%
    \fill[turnwhoc] ([xshift=-4.2mm]frame.west) circle (1.1mm);
    \begin{scope}[shift={([xshift=-11.5mm]frame.west)}, x=0.8mm, y=0.8mm]
      % the box is drawn at 0.8, but node text does not scale with the unit vectors
      \renewcommand{\icmodelfont}{\tiny}%
      \turnwhoicon{#2}
    \end{scope}}}
\newtcolorbox{turnthinks}[1][REASON]{enhanced, colback=NovaBg, colframe=NovaBg, boxrule=0pt, arc=2.4mm,
  borderline={0.9pt}{0pt}{NovaLine, dash pattern=on 1.5mm off 1.1mm},
  left=3.4mm, right=3.4mm, top=1.1mm, bottom=1.1mm,
  width=\dimexpr\linewidth-24mm\relax, enlarge left by=24mm,
  fontupper=\scriptsize\itshape\raggedright\color{NovaMuted},
  overlay={%
    \draw[NovaLine, line width=0.9pt] ([xshift=-4.2mm, yshift=1.8mm]frame.north west)
      -- ([xshift=-4.2mm, yshift=-1.8mm]frame.south west);
    \fill[NovaPurple] ([xshift=-4.2mm]frame.west) circle (1.1mm);
    \node[anchor=east, font=\scriptsize\bfseries, text=NovaPurple, inner sep=0pt]
      at ([xshift=-8mm]frame.west) {\lsp[12]{#1}};}}

% ─────────────────────────────────────────────────────────── flat icons
% Drawn, not imported: no icon font is guaranteed on the presenting machine, and a hand-drawn
% glyph in the deck's own line weight sits better next to the cards than a pasted symbol.
% Each takes [colour]{x}{y} and is about 7mm tall, meant for a picture with x=1mm, y=1mm.
% f(x), not a sparkle: the sparkle is the industry's mark for magic, and the whole history act
% argues the opposite — a model is a function, text in and numbers out. \icmodelfont lets a
% caller that draws the icon smaller shrink the glyph with it.
\newcommand{\icmodelfont}{\scriptsize}
\newcommand{\icmodel}[3][NovaPurple]{%
  \begin{scope}[shift={(#2,#3)}]
    \draw[#1, line width=1.1pt, rounded corners=1mm] (-3.5,-3.5) rectangle (3.5,3.5);
    \node[text=#1, inner sep=0pt, font=\icmodelfont] at (0,0.1) {$f(x)$};
  \end{scope}}
\newcommand{\icperson}[3][NovaBody]{%
  \begin{scope}[shift={(#2,#3)}]
    \draw[#1, line width=1.1pt] (0,1.7) circle (1.5);
    \draw[#1, line width=1.1pt] (-3.0,-3.5) arc (180:0:3.0 and 3.3);
  \end{scope}}
\newcommand{\iclaptop}[3][NovaBody]{%
  \begin{scope}[shift={(#2,#3)}]
    \draw[#1, line width=1.1pt, rounded corners=0.5mm] (-3.3,-1.0) rectangle (3.3,3.0);
    \draw[#1, line width=1.1pt] (-4.6,-2.6) -- (4.6,-2.6);
    \draw[#1, line width=1.1pt] (-3.3,-1.0) -- (-4.6,-2.6);
    \draw[#1, line width=1.1pt] (3.3,-1.0) -- (4.6,-2.6);
  \end{scope}}
% The harness gets no icon on the stack slides — there it IS the card everything else sits
% inside — so it gets one here: a window with a prompt in it, wider and shorter than \icmodel's
% square so the two silhouettes never read as the same thing. Drawn rather than a vendor mark:
% Codex is the harness on their laptops, but the word on the slide is "harness".
\newcommand{\icharness}[3][NovaAccent]{%
  \begin{scope}[shift={(#2,#3)}]
    \draw[#1, line width=1.1pt, rounded corners=1mm] (-4.0,-2.7) rectangle (4.0,2.7);
    \draw[#1, line width=1.1pt] (-2.1,1.0) -- (-0.9,0) -- (-2.1,-1.0);
    \draw[#1, line width=1.1pt] (0.2,-1.0) -- (2.3,-1.0);
  \end{scope}}
% The harness slide names a category, not a product, so it is labelled with the products
% themselves. Marks: OpenAI's 2025 symbol (Wikimedia, public domain) for Codex, Antigravity's own
% site icon, and Simple Icons (CC0) for Claude Code, Pi and OpenCode. All flattened to one ink —
% five brand palettes at the top of a slide would read as a sponsor wall, not as examples.
\newcommand{\harnessmark}[3]{%
  \raisebox{-0.32ex}{\includegraphics[height=3.1mm]{figures/logo-#1.#2}}\hskip1.0mm #3}
\newcommand{\harnessrow}{%
  \harnessmark{codex}{pdf}{Codex}\hskip3.4mm
  \harnessmark{antigravity}{png}{Antigravity}\hskip3.4mm
  \harnessmark{claudecode}{pdf}{Claude Code}\hskip3.4mm
  \harnessmark{pi}{pdf}{Pi}\hskip3.4mm
  \harnessmark{opencode}{pdf}{OpenCode}}

% six short fat teeth read as a gear; eight thin ones read as a sun
\newcommand{\icgear}[3][NovaBlue]{%
  \begin{scope}[shift={(#2,#3)}]
    \foreach \a in {0,60,...,300} {\draw[#1, line width=2.6pt] (\a:2.1) -- (\a:3.4);}
    \draw[#1, line width=1.3pt] (0,0) circle (2.2);
    \draw[#1, line width=1.3pt] (0,0) circle (1.0);
  \end{scope}}

% a cloud with one clean outline: every part is stroked wide first, then the same parts are
% filled on top, so the seams between them disappear and only the union's edge remains.
% \cloud{x}{y} centres the base at (x,y); it spans about 88 x 23 mm, top at y+15.5
\newcommand{\cloudparts}[3]{%
  \path[#3, rounded corners=6.5mm] ({#1-44},{#2+6}) rectangle ({#1+44},{#2-7});
  \path[#3] ({#1-24},{#2+4}) circle (7.5);
  \path[#3] ({#1+1},{#2+6}) circle (9.5);
  \path[#3] ({#1+25},{#2+4}) circle (7.5);}
\newcommand{\cloud}[2]{%
  \cloudparts{#1}{#2}{draw=NovaBlue, line width=2.2pt}
  \cloudparts{#1}{#2}{fill=NovaBlueBg}}

% a laptop big enough to carry a commit graph on its screen: \screen{x}{y} puts the screen's
% top-left corner at (x,y); the screen is 46 x 16 mm and the base sits under it
\newcommand{\screen}[2]{%
  \path[rounded corners=1.6mm, fill=NovaCard, draw=NovaBody, line width=1.1pt]
    (#1,#2) rectangle ({#1+46},{#2-16});
  \draw[NovaBody, line width=1.1pt] ({#1-3},{#2-18.4}) -- ({#1+49},{#2-18.4});
  \draw[NovaBody, line width=1.1pt] (#1,{#2-16}) -- ({#1-3},{#2-18.4});
  \draw[NovaBody, line width=1.1pt] ({#1+46},{#2-16}) -- ({#1+49},{#2-18.4});}

% ─────────────────────────────────────────────────────────────── git, drawn
% The git act is one commit graph shown five times, plus one picture of where the work lives.
% Both were Mermaid; Mermaid sized each gitGraph to its own content, so the graph jumped and
% rescaled between slides and a Python pass had to re-align the five PDFs on the main badge.
% Drawing all five stages from one macro on a fixed canvas removes the problem instead of
% correcting it: the graph now holds still because it is literally the same picture, grown.
\tikzset{
  gg lane/.style  ={draw=#1, line width=2.4pt, line cap=round},
  gg dot/.style   ={circle, fill=#1, draw=NovaBg, line width=1.2pt,
                    inner sep=0pt, minimum size=6.6pt},
  gg open/.style  ={circle, fill=NovaBg, draw=#1, line width=2.2pt,
                    inner sep=0pt, minimum size=5.6pt},
  gg pill/.style  ={rounded corners=1.5mm, fill=#1, text=white, font=\scriptsize\bfseries,
                    inner xsep=2.6mm, inner ysep=1.3mm},
  gg note/.style  ={font=\scriptsize, text=NovaBody, inner sep=0pt, inner ysep=1.3mm},
  gg tag/.style   ={font=\scriptsize\bfseries, text=#1, inner sep=0pt, inner ysep=1.5mm},
  % places: the two boxes on the local/remote slide
  % shadows.blur builds its fade out of a box and drags the footer in with it, typesetting the
  % slide number in \nullfont; a plain offset copy is indistinguishable at projection size
  gp card/.style  ={rounded corners=3.6mm, fill=#1, draw=none,
                    drop shadow={shadow xshift=0.4mm, shadow yshift=-0.45mm,
                                 fill=NovaShadow, opacity=1}},
  gp eyebrow/.style={font=\scriptsize\bfseries, text=#1, anchor=south west, inner sep=0pt},
  gp head/.style  ={font=\scriptsize\bfseries, text=NovaFg, anchor=north, align=center,
                    inner sep=0pt},
  gp body/.style  ={font=\scriptsize, text=NovaBody, anchor=north, align=center, inner sep=0pt},
  gp file/.style  ={rounded corners=1.2mm, fill=NovaBg, text=NovaBody, font=\tiny\ttfamily,
                    inner xsep=1.8mm, inner ysep=1.1mm},
  gp move/.style  ={-{Stealth[length=2.2mm, width=1.8mm]}, draw=#1, line width=1.4pt},
  gp movelabel/.style={font=\scriptsize\bfseries, text=#1, inner sep=0pt, inner ysep=1.1mm},
}
% \gpchain{x from}{x to}{y}{colour} — three commits on a line, the shorthand for "a history"
\newcommand{\gpchain}[4]{%
  \draw[gg lane=#4] (#1,#3) -- (#2,#3);
  \node[gg dot=#4] at (#1,#3) {};
  \node[gg dot=#4] at ({(#1+#2)/2},#3) {};
  \node[gg dot=#4] at (#2,#3) {};}

% \gitgraph{stage} — stage 1..5 of the same graph. x is a fraction of \linewidth, y is mm.
\newlength{\ggw}
\newcommand{\gitgraph}[1]{%
  \setlength{\ggw}{\linewidth}%
  \par\noindent\begin{tikzpicture}[x=\ggw, y=1mm]
    \useasboundingbox (0,-17) rectangle (1,14);
    % main runs the full width from the first slide on: it is never the thing that moves
    \draw[gg lane=NovaTeal] (0.12,7) -- (1,7);
    \node[gg pill=NovaTeal, anchor=east] at (0.105,7) {main};
    \node[gg dot=NovaTeal] at (0.22,7) {};
    \node[gg note, anchor=south] at (0.22,10) {feature 1};
    \ifnum#1>1
      \draw[gg lane=NovaAccent] (0.22,7) .. controls (0.30,7) and (0.29,-7) .. (0.37,-7)
                                -- (0.53,-7);
      \node[gg pill=NovaAccent, anchor=north west] at (0.365,-10.4) {feature-2};
    \fi
    \ifnum#1>2
      \node[gg dot=NovaAccent] at (0.53,-7) {};
      \node[gg note, anchor=south] at (0.53,-4) {column};
    \fi
    \ifnum#1>3
      \draw[gg lane=NovaAccent] (0.53,-7) -- (0.70,-7);
      \node[gg dot=NovaAccent] at (0.70,-7) {};
      \node[gg note, anchor=south] at (0.70,-4) {totals};
    \fi
    \ifnum#1>4
      \draw[gg lane=NovaTeal] (0.70,-7) .. controls (0.78,-7) and (0.79,7) .. (0.87,7);
      \node[gg open=NovaTeal] at (0.87,7) {};
      \node[gg tag=NovaTeal, anchor=south] at (0.87,10) {approved};
    \fi
  \end{tikzpicture}%
}

% \gitconflict{stage} — the same graph with two branches off one commit, both editing one file.
% Stage 1 is the divergence; stage 2 is what happens when the second one comes home to a main
% that moved under it. Built in two stages like \gitgraph so it can be split across two slides
% later without redrawing anything; used as one picture today.
\newcommand{\gitconflict}[1]{%
  \setlength{\ggw}{\linewidth}%
  % y is squeezed to 0.82mm so the picture and a five-line conflict card both fit the frame:
  % positions compress, type does not, which is why the coordinates below are unchanged
  \par\noindent\begin{tikzpicture}[x=\ggw, y=0.82mm]
    \useasboundingbox (0,-22) rectangle (1,22);
    % main sits in the middle so the two branches come home from opposite sides and the merge
    % curves never cross; the file chips live in the two gaps, each beside its own commit
    \draw[gg lane=NovaTeal] (0.12,0) -- (1,0);
    \node[gg pill=NovaTeal, anchor=east] at (0.105,0) {main};
    \node[gg dot=NovaTeal] at (0.22,0) {};
    % feature-a, above
    \draw[gg lane=NovaAccent] (0.22,0) .. controls (0.31,0) and (0.30,14) .. (0.39,14) -- (0.54,14);
    \node[gg dot=NovaAccent] at (0.54,14) {};
    \node[gg tag=NovaAccent, anchor=south] at (0.44,16.2) {feature-a};
    \node[gp file, fill=NovaCard, anchor=north] at (0.545,11.2) {logic.py};
    % feature-b, below
    \draw[gg lane=NovaPurple] (0.22,0) .. controls (0.31,0) and (0.30,-14) .. (0.39,-14) -- (0.54,-14);
    \node[gg dot=NovaPurple] at (0.54,-14) {};
    \node[gg tag=NovaPurple, anchor=north] at (0.44,-16.2) {feature-b};
    \node[gp file, fill=NovaCard, anchor=south] at (0.545,-11.2) {logic.py};
    \ifnum#1>1
      % a comes home first, and main moves under b
      \draw[gg lane=NovaAccent] (0.54,14) .. controls (0.66,14) and (0.67,0) .. (0.76,0);
      \node[gg dot=NovaTeal] at (0.76,0) {};
      \node[gg tag=NovaTeal, anchor=south] at (0.785,1.8) {merged};
      % b arrives at a file that no longer looks the way it did when it left
      \draw[gg lane=NovaPurple, dash pattern=on 2mm off 1.6mm]
        (0.54,-14) .. controls (0.70,-14) and (0.72,0) .. (0.815,0);
      \node[gg pill=NovaYellow, anchor=west] at (0.822,0) {conflict};
    \fi
  \end{tikzpicture}%
}

% ─────────────────────────────────────────────────────────── git log, drawn
% The history the way GitHub Desktop's History tab shows it, which is what they will see: one
% panel, the commits as rows on the left with the graph's two lanes running through them, and
% the selected commit's diff in the pane on the right. The five commits are the five from
% \gitgraph, in its colours. Every row says what, who and when; the selected one shows its
% change; the chip in the pane header is the way back. Drawn on one canvas (a list beside a
% floating diff card was tried first, 2026-09-22, and looked stuck together).
\tikzset{
  gl hash/.style ={font=\tiny\ttfamily, text=NovaMuted, anchor=east, inner sep=0pt},
  gl msg/.style  ={font=\scriptsize\bfseries, text=NovaFg, anchor=west, inner sep=0pt},
  gl who/.style  ={font=\tiny, text=NovaBody, anchor=west, inner sep=0pt},
  gl code/.style ={font=\scriptsize\ttfamily, anchor=west, inner sep=0pt},
}
% \gitlogrow{y}{hash}{message}{who · when}: the text of one row; the dot is placed by the caller
\newcommand{\gitlogrow}[4]{%
  \node[gl msg]  at (14,{#1+1.6}) {#3};
  \node[gl who]  at (14,{#1-2.3}) {#4};
  \node[gl hash] at (57,#1) {#2};}
\newcommand{\gitlog}{%
  \par\noindent\begin{tikzpicture}[x=1mm, y=1mm]
    \useasboundingbox (0,-47) rectangle (134,1);
    % the panel, its header band, and the split between the two panes
    \path[gp card=NovaBg] (0,0) rectangle (134,-46);
    \draw[NovaLine, line width=0.9pt, rounded corners=2.4mm] (0,0) rectangle (134,-46);
    \draw[NovaLine, line width=0.7pt] (0.5,-6.5) -- (133.5,-6.5) (60,-0.5) -- (60,-45.5);
    \node[pg head] at (4,-3.3) {\lsp[12]{HISTORY}};
    % ── left pane: the rows, the selected one filled
    \path[fill=NovaCard] (0.6,-24.1) rectangle (59.4,-31.9);
    \draw[gg lane=NovaTeal] (5,-12) -- (5,-36);
    \draw[gg lane=NovaAccent] (5,-36) .. controls (5,-33) and (9.5,-35) .. (9.5,-32) -- (9.5,-16)
      .. controls (9.5,-13) and (5,-15) .. (5,-12);
    \node[gg open=NovaTeal]  at (5,-12)   {};
    \node[gg dot=NovaAccent] at (9.5,-20) {};
    \node[gg dot=NovaAccent] at (9.5,-28) {};
    \node[gg dot=NovaTeal]   at (5,-36)   {};
    \gitlogrow{-12}{c41d8e2}{Merge feature-2: categories}{you · today, 10:42}
    \gitlogrow{-20}{7d21e0b}{Add the totals}{you · yesterday, 17:05}
    \gitlogrow{-28}{4c8ab77}{Add the category column}{you · yesterday, 14:02}
    \gitlogrow{-36}{91e04d5}{Feature 1: balances}{you · 15 Sep}
    % ── right pane: the selected commit, and its one change
    \node[cx mono] at (64,-3.3) {4c8ab77};
    \node[gl who, text=NovaFg] at (78,-3.3) {Add the category column · you};
    \node[rounded corners=1.2mm, draw=NovaBody, line width=0.6pt, text=NovaBody, font=\tiny\bfseries,
          inner xsep=1.8mm, inner ysep=0.9mm, anchor=east] at (130.5,-3.3) {go back to here};
    \node[font=\tiny\ttfamily, text=NovaMuted, anchor=west, inner sep=0pt] at (64,-11) {db.py};
    \node[gl code, text=NovaBody] at (64,-15.6) {\ \ COLUMNS = ["id", "payer", "amount",};
    \fill[NovaAccent!10!NovaBg] (60.5,-18.4) rectangle (133.5,-24.4);
    \node[gl code, text=NovaAccent] at (64,-21.4) {-\ \ \ \ \ \ \ \ \ \ \ \ "date"]};
    \fill[NovaTeal!12!NovaBg] (60.5,-24.4) rectangle (133.5,-30.4);
    \node[gl code, text=NovaTeal] at (64,-27.4) {+\ \ \ \ \ \ \ \ \ \ \ \ "date", "category"]};
    \node[font=\tiny, text=NovaMuted, anchor=west, inner sep=0pt] at (64,-35) {1 file changed · 1 line};
  \end{tikzpicture}%
}

% ──────────────────────────────────────────────── from a model to an agent
% One canvas, four stages, like the git graph: a language model, then tools, then the loop that
% makes it an agent, then the harness drawn around all of it. Because nothing moves between
% stages, the eye only has to register what was added. \agentstack{1..4}
\tikzset{
  as arrow/.style ={-{Stealth[length=2.2mm, width=1.8mm]}, draw=#1, line width=1.3pt},
  as label/.style ={font=\scriptsize\bfseries, text=#1, inner sep=0pt, inner ysep=1.0mm},
  as name/.style  ={font=\scriptsize, text=NovaBody, anchor=north, inner sep=0pt},
  as chip/.style  ={rounded corners=1.2mm, fill=NovaCard, text=NovaFg, font=\scriptsize\bfseries,
                    inner xsep=2.2mm, inner ysep=1.2mm},
  as ghost/.style ={circle, draw=NovaLine, line width=0.8pt, dash pattern=on 1.2mm off 1mm,
                    inner sep=0pt, minimum size=12mm},
}
\newcommand{\agentstack}[1]{%
  \par\noindent\begin{tikzpicture}[x=1mm, y=1mm]
    % stage 1 is a slide of its own now that the placeholder circle is gone, so it gets a box
    % its own size and is shifted to the middle of it; from stage 2 the canvas fills out to the
    % right and the pair sits where it stays for the rest of the build
    \useasboundingbox (0,\ifnum#1<2 -26\else -46\fi) rectangle (134,4);
    % stage 4: the harness is the box everything else was already inside
    \ifnum#1>3
      \path[gp card=NovaPurpleBg] (24,-1) rectangle (134,-44);
      \node[anchor=west, inner sep=0pt, font=\scriptsize, text=NovaBody] at (24,1.6) {\harnessrow};
      \node[as chip, draw=NovaPurple, line width=0.8pt, font=\scriptsize\bfseries,
            text=NovaPurple] at (24,-16) {may I?};
      % the harness's three jobs, as a footer inside its own box rather than one long dotted
      % line: a hairline separates them from the loop above, and each sits in its own third
      \draw[NovaPurple, opacity=0.28, line width=0.5pt] (28,-38.6) -- (130,-38.6);
      % x set per item, not on a stride: the three phrases are 27, 33 and 18mm wide
      \foreach \x/\t in {28.8/{reads the rulebook first},
                         64.5/{keeps the whole conversation},
                         107/{runs every tool}} {%
        \fill[NovaPurple] (\x,-41.4) circle (0.6);
        \node[anchor=west, inner sep=0pt, text=NovaPurple, font=\scriptsize]
          at ({\x+1.8},-41.4) {\t};}
    \fi
    % you, and the model: text goes in, text comes out
    \ifnum#1<2 \begin{scope}[xshift=32.5mm] \fi
    \icperson[NovaBody]{12}{-15}
    \node[as name] at (12,-22.5) {you};
    \icmodel[NovaPurple]{58}{-16}
    \node[as name] at (58,-22.5) {model};
    \draw[as arrow=NovaBody] (18,-12.5) -- (52,-12.5);
    \node[as label=NovaBody, anchor=south] at (35,-11.7) {you type};
    \draw[as arrow=NovaBody] (52,-19.5) -- (18,-19.5);
    \node[as label=NovaBody, anchor=north] at (35,-20.3) {it writes};
    \ifnum#1<2 \end{scope} \fi
    % stage 2: tools, and the result comes back to the model
    \ifnum#1>1
      \iclaptop[NovaPurple]{108}{-16}
      \node[as name] at (108,-22.5) {your laptop};
      \node[as chip] (t1) at (96,-29.5) {read};
      \node[as chip] (t2) at (108,-29.5) {edit};
      \node[as chip] (t3) at (120,-29.5) {run};
      \draw[as arrow=NovaPurple] (65,-12.5) -- (100,-12.5);
      \node[as label=NovaPurple, anchor=south] at (82.5,-11.7) {asks for a tool};
      \draw[as arrow=NovaPurple] (100,-19.5) -- (65,-19.5);
      \node[as label=NovaPurple, anchor=north] at (82.5,-20.3) {tool results};
    \fi
    % stage 3: the loop; the result is read and the next call chosen, until done
    \ifnum#1>2
      \draw[as arrow=NovaAccent, rounded corners=2mm]
        (108,-33) -- (108,-37.5) -- (66,-37.5) -- (66,-22);
      \node[as label=NovaAccent, fill=\ifnum#1>3 NovaPurpleBg\else NovaBg\fi,
            inner xsep=1.6mm, anchor=center] at (87,-37.5) {again, until done};
    \fi
  \end{tikzpicture}%
}

% ───────────────────────────────────────────────────────────── the ReAct ring
% The one architecture the class rests on, drawn once and reused: three cards in a row, the
% "not yet" return underneath, the "done" exit to the right. \reactring{reason}{act}{observe}{stop}
% hierarchy inside the card: the step name is \small bold in the act's colour with a hairline
% under it, the description is \scriptsize body text well clear of it. At the same size and two
% millimetres apart the two read as one block, which is what they were doing.
\newcommand{\reactcard}[4]{%
  \path[gp card=NovaCard] (#1,-3) rectangle ({#1+30},-23);
  \node[text=#4, font=\small\bfseries, anchor=north west, inner sep=0pt]
    at ({#1+3.4},-6.2) {\lsp[8]{#2}};
  \draw[#4, opacity=0.3, line width=0.5pt] ({#1+3.4},-11.2) -- ({#1+26.6},-11.2);
  \node[gp body, anchor=north west, align=left, text width=23.2mm] at ({#1+3.4},-13.4) {#3};}
\newcommand{\reactring}[4]{%
  \par\noindent\begin{tikzpicture}[x=1mm, y=1mm]
    % arrows ride the cards' new centre line (-13, for cards spanning -3 to -23)
    \useasboundingbox (0,-32.5) rectangle (134,0);
    \reactcard{0}{REASON}{#1}{NovaPurple}
    \reactcard{40}{ACT}{#2}{NovaPurple}
    \reactcard{80}{OBSERVE}{#3}{NovaPurple}
    \draw[as arrow=NovaBody] (30.6,-13) -- (39.4,-13);
    \draw[as arrow=NovaBody] (70.6,-13) -- (79.4,-13);
    \draw[as arrow=NovaAccent, rounded corners=2mm] (95,-23.6) -- (95,-29) -- (15,-29) -- (15,-23.6);
    \node[as label=NovaAccent, fill=NovaBg, inner xsep=1.6mm, anchor=center] at (55,-29) {not yet};
    \draw[as arrow=NovaTeal] (110.6,-13) -- (119.4,-13);
    \node[gg open=NovaTeal] at (122.6,-13) {};
    \node[as label=NovaTeal, anchor=north, align=center, text width=22mm] at (125,-15.6) {#4};
  \end{tikzpicture}%
}

% ─────────────────────────────────────────────── the three questions
% The bridge into Act 3 in the room's own words: three questions anyone asks before handing
% work to someone, each answered in one line, each with the tool word underneath. \threeqs.
\tikzset{
  tq q/.style    ={font=\small\bfseries, text=NovaFg, anchor=north west, align=left,
                   text width=40mm, inner sep=0pt},
  tq a/.style    ={font=\scriptsize, text=NovaBody, anchor=north west, align=left,
                   text width=40mm, inner sep=0pt},
  tq chip/.style ={rounded corners=1.2mm, fill=#1, text=NovaBg, font=\tiny\bfseries,
