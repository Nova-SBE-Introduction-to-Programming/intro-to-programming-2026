\newcommand{\cxoffset}[1]{\def\cxoff{#1}}
% the back of the box: back wall, left inner wall, floor — drawn before the cards
\newcommand{\cxback}{%
  \path[cx face=NovaChip]  ({\cxdepth*\cxdx},{\cxdepth*\cxdy}) rectangle ({\cxw+4+\cxdepth*\cxdx},{\cxdepth*\cxdy+\cxwall});
  \path[cx face=NovaCard2] (0,0) -- ({\cxdepth*\cxdx},{\cxdepth*\cxdy}) -- ({\cxdepth*\cxdx},{\cxdepth*\cxdy+\cxwall}) -- (0,\cxwall) -- cycle;
  \path[cx face=NovaLine]  (0,0) -- ({\cxw+4},0) -- ({\cxw+4+\cxdepth*\cxdx},{\cxdepth*\cxdy}) -- ({\cxdepth*\cxdx},{\cxdepth*\cxdy}) -- cycle;}
% the front of the box: right outer wall and front wall — drawn after the cards
\newcommand{\cxfront}{%
  \path[cx face=NovaShadow] ({\cxw+4},0) -- ({\cxw+4+\cxdepth*\cxdx},{\cxdepth*\cxdy}) -- ({\cxw+4+\cxdepth*\cxdx},{\cxdepth*\cxdy+\cxwall}) -- ({\cxw+4},\cxwall) -- cycle;
  \path[cx face=NovaCard]  (0,0) rectangle ({\cxw+4},\cxwall);}
% a standing card in row #1 (0 = front): the slab, its tag and, on its top line, whatever #4 draws
% at the card's own origin (x = card left + 18.5, y = card top - 3.4)
% [fill]: the cards that are there before the first thought — the tools and the rulebook — are
% tinted — pale teal, not amber: anything warm disappears against the cream box — so the two
