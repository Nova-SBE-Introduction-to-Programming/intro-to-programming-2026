% \cxgeom{dx}{dy}{card width}{wall height}{card height}{rows to the back wall}
\newcommand{\cxgeom}[6]{\def\cxdx{#1}\def\cxdy{#2}\def\cxw{#3}\def\cxwall{#4}\def\cxcardh{#5}\def\cxdepth{#6}\def\cxoff{0}}
