flowchart LR
  RED["RED<br/>the tests say what is missing"]
  B["BUILD<br/>one task, one branch"]
  RUN["RUN THE TESTS"]
  Q{"green?"}
  STOP["STOP<br/>read the diff · click the app"]
  READ["READ THE FAILURE<br/>what, and where"]
  NEW["NEW THREAD<br/>better prompt"]
  RED --> B --> RUN --> Q
  Q -->|"yes"| STOP
  Q -->|"no"| READ
  READ --> B
  READ -.->|"same failure twice"| NEW
  NEW -.-> B
